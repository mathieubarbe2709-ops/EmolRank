# Copiez ce fichier en ".env" et renseignez votre jeton (https://start.gg/admin/profile/developer)
STARTGG_TOKEN=
# Réglages facultatifs
# ELO_INITIAL=1000
# ELO_K=32
# ELO_LOSERS_WEIGHT=0.6
# ELO_LOSS_FACTOR=0.7   (part du gain perdue par le perdant ; 1 = ELO classique)
# ELO_DECAY=5           (points perdus par tournoi manqué)
# WIKI_DIR=data/wiki    (textes des pages Wiki)
# PORT=5000
